# GSDN PMIS API settings. Copy to .env or give them to the service (the installer writes /etc/gsdn-pmis/pmis.env).
# Placeholders only: never commit real values.
NODE_ENV=production
HOST=127.0.0.1
PORT=3000
# false only for local development over plain http
COOKIE_SECURE=true
# The application connects as the role pmis_app (never as a superuser). connection_limit is optional.
DATABASE_URL=postgresql://pmis_app:CHANGE_ME@127.0.0.1:5432/pmis?connection_limit=10
# At least 32 random characters; used to mask identifiers in logs. Generate with: openssl rand -hex 32
LOG_HMAC_KEY=CHANGE_ME_TO_64_HEX_CHARACTERS
# Exactly 32 bytes as 64 hex characters (or base64): the AES-256-GCM key that encrypts the two-factor (TOTP) secrets at rest, and the base of the
# recovery-code hash key. Generate with: openssl rand -hex 32. Required. KEEP IT: if it is lost or changed, every enrolled user must be reset and enrol again.
TOTP_ENC_KEY=CHANGE_ME_TO_64_HEX_CHARACTERS
# Daily job (SLA versions that take effect, 14-day reminder of tentative holidays): once at start-up and every day at 02:00 Africa/Tripoli.
# Absent = true, except when NODE_ENV=test. Set false to switch it off (it must run in one API process only if you run several: an advisory lock protects it anyway).
JOBS_ENABLED=true

# Document storage (ADR 0008). Local disk by default: the directory must be writable by the API user and is never served directly.
STORAGE_DIR=/var/lib/gsdn-pmis/files
# S3-compatible object storage (MinIO on-prem) instead of the directory: set all four. The bucket stays private; every download goes through the API.
# S3_ENDPOINT=http://127.0.0.1:9000
# S3_BUCKET=pmis
# S3_ACCESS_KEY=CHANGE_ME
# S3_SECRET_KEY=CHANGE_ME
# S3_REGION=us-east-1

# Encryption at rest of the stored files (migration 0048). FILE_ENC_KEY is required: exactly 32 bytes (64 hex characters or base64). Generate
# with: openssl rand -hex 32. The installer generates it and keeps it on update. KEEP IT OFFLINE TOO: without this key the stored files cannot
# be read, even from a good backup. FILE_ENC_KEY_ID names the active key (letters, digits, _ and -; default k1). FILE_ENC_OLD_KEYS keeps the
# earlier keys while the data keys are rewrapped during a rotation (id:key,id:key). Rotation: see infra/RUNBOOK.md.
FILE_ENC_KEY=CHANGE_ME_TO_64_HEX_CHARACTERS
FILE_ENC_KEY_ID=k1
# FILE_ENC_OLD_KEYS=k0:CHANGE_ME_TO_64_HEX_CHARACTERS

# Virus scan of uploads (owner answer Q134). off (default; a warning is logged at start-up) or clamd: every upload is scanned by clamd before it
# is stored. Install ClamAV with tools/install/install-clamav.sh. CLAMD_SOCKET (unix socket, the installer uses /run/clamav/clamd.ctl) or
# CLAMD_HOST and CLAMD_PORT (TCP, default 127.0.0.1:3310). CLAMD_TIMEOUT_MS is the time allowed per file (default 120000).
# SCAN_FAILURE: fail_closed (default) refuses the upload with 503 malware_scan_unavailable while clamd is down; fail_open stores the file,
# flags it pending_rescan and the nightly job (04:00) scans it later. Either way the event is written to the System Log.
MALWARE_SCAN=off
# MALWARE_SCAN=clamd
# CLAMD_SOCKET=/run/clamav/clamd.ctl
# CLAMD_HOST=127.0.0.1
# CLAMD_PORT=3310
# CLAMD_TIMEOUT_MS=120000
# SCAN_FAILURE=fail_closed
