# GSDN PMIS API settings. Copy to .env or give them to the service (the installer writes /etc/gsdn-pmis/pmis.env).
# Placeholders only: never commit real values.
NODE_ENV=production
HOST=127.0.0.1
PORT=3000
# false only for local development over plain http
COOKIE_SECURE=true
# The application connects as the role pmis_app (never as a superuser). connection_limit is optional.
DATABASE_URL=postgresql://pmis_app:CHANGE_ME@127.0.0.1:5432/pmis?connection_limit=10
# At least 32 random characters; used to mask identifiers in logs. Generate with: openssl rand -hex 32
LOG_HMAC_KEY=CHANGE_ME_TO_64_HEX_CHARACTERS
# Exactly 32 bytes as 64 hex characters (or base64): the AES-256-GCM key that encrypts the two-factor (TOTP) secrets at rest, and the base of the
# recovery-code hash key. Generate with: openssl rand -hex 32. Required. KEEP IT: if it is lost or changed, every enrolled user must be reset and enrol again.
TOTP_ENC_KEY=CHANGE_ME_TO_64_HEX_CHARACTERS
# Daily job (SLA versions that take effect, 14-day reminder of tentative holidays): once at start-up and every day at 02:00 Africa/Tripoli.
# Absent = true, except when NODE_ENV=test. Set false to switch it off (it must run in one API process only if you run several: an advisory lock protects it anyway).
JOBS_ENABLED=true

# Document storage (ADR 0008). Local disk by default: the directory must be writable by the API user and is never served directly.
STORAGE_DIR=/var/lib/gsdn-pmis/files
# S3-compatible object storage (MinIO on-prem) instead of the directory: set all four. The bucket stays private; every download goes through the API.
# S3_ENDPOINT=http://127.0.0.1:9000
# S3_BUCKET=pmis
# S3_ACCESS_KEY=CHANGE_ME
# S3_SECRET_KEY=CHANGE_ME
# S3_REGION=us-east-1
