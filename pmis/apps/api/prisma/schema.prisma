  closure_approval_date    DateTime? @db.Date
  closure_ready            Boolean   @default(false)
  custom                   Json      @default("{}") @db.JsonB // admin-defined fields, validated by trigger

  @@index([region_id])
  @@index([custom], type: Gin)
  @@map("readiness_handover")
}

model AsBuiltRecord {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  site_id        String    @unique @db.Uuid
  region_id      Int
  site           Site      @relation(fields: [site_id, region_id], references: [id, region_id], onUpdate: Cascade)
  submitted_date DateTime? @db.Date
  quantities     Json // item -> quantity (tower m, cables, trays, rods ...)
  custom         Json      @default("{}") @db.JsonB // admin-defined fields, validated by trigger

  @@index([region_id])
  @@index([custom], type: Gin)
  @@map("as_built_records")
}

model Meeting {
  id           String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  title        String
  meeting_date DateTime        @db.Timestamptz(6)
  region_id    Int?
  is_global    Boolean         @default(false) // explicit global row; NULL region alone never means global
  attendees    Json?
  minutes      String?
  actions      MeetingAction[]
  custom       Json            @default("{}") @db.JsonB // admin-defined fields, validated by trigger

  @@index([meeting_date])
  @@index([custom], type: Gin)
  @@map("meetings")
}

model MeetingAction {
  id          String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  meeting_id  String         @db.Uuid
  description String
  owner_id    String?        @db.Uuid
  due_date    DateTime?      @db.Date
  status      RegisterStatus @default(open)
  site_id     String?        @db.Uuid
  meeting     Meeting        @relation(fields: [meeting_id], references: [id], onDelete: Cascade)

  @@index([meeting_id])
  @@map("meeting_actions")
}

// ============================================================================
// 9. LOGS AND SETTINGS
// ============================================================================

// Append-only. Enforced by triggers in db/sql/001_audit_append_only.sql plus REVOKE UPDATE, DELETE.
model AuditLog {
  id                BigInt   @id @default(autoincrement())
  at                DateTime @default(now()) @db.Timestamptz(6)
  actor_id          String?  @db.Uuid
  on_behalf_of      String?  @db.Uuid
  action            String // create, update, delete, approve, reject, download, login, override ...
  entity_type       String
  entity_id         String?
  site_id           String?  @db.Uuid
  region_id         Int?
  before            Json?
  after             Json?
  reason            String?
  is_admin_override Boolean  @default(false)
  ip                String?
  user_agent        String?
  request_id        String?

  @@index([entity_type, entity_id])
  @@index([actor_id, at])
  @@index([site_id, at])
  @@index([at])
  @@map("audit_log")
}

// Separate from the audit log; purged after 12 months by a scheduled job.
model SystemLog {
  id         BigInt   @id @default(autoincrement())
  at         DateTime @default(now()) @db.Timestamptz(6)
  level      LogLevel
  source     String // api, importer, template-check, job
  message    String
  context    Json?
  user_id    String?  @db.Uuid
  request_id String?

  @@index([at])
  @@index([level, at])
  @@index([source, at])
  @@map("system_log")
}

model Setting {
  key         String   @id // require_mfa, geofence_radius_m, sla.default_levels ...
  value       Json
  description String?
  updated_by  String?  @db.Uuid
  updated_at  DateTime @updatedAt @db.Timestamptz(6)

  @@map("settings")
}

// Departments, messages and announcements (migration 0011, ADR 0013). pmis_app only reads these tables (row-level
// security); writes go through idm_department_save / idm_set_user_org, msg_* and ann_* functions.
model Department {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code       String   @unique
  name_en    String
  name_ar    String?
  is_active  Boolean  @default(true)
  created_at DateTime @default(now()) @db.Timestamptz(6)
  updated_at DateTime @default(now()) @db.Timestamptz(6)

  users User[]

  @@map("departments")
}

model MessageThread {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  subject         String
  created_by      String   @db.Uuid
  created_at      DateTime @default(now()) @db.Timestamptz(6)
  last_message_at DateTime @default(now()) @db.Timestamptz(6)

  creator      User                 @relation(fields: [created_by], references: [id], onDelete: NoAction, onUpdate: NoAction)
  participants MessageParticipant[]
  messages     Message[]

  @@map("message_threads")
}

model MessageParticipant {
  thread_id    String    @db.Uuid
  user_id      String    @db.Uuid
  last_read_at DateTime? @db.Timestamptz(6)

  thread MessageThread @relation(fields: [thread_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  user   User          @relation(fields: [user_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@id([thread_id, user_id])
  @@index([user_id], map: "message_participants_user_idx")
  @@map("message_participants")
}

// Append-only (trigger). The original message has is_original = true; replies are shown newest first under it.
model Message {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  thread_id   String   @db.Uuid
  author_id   String   @db.Uuid
  body        String
  is_original Boolean  @default(false)
  created_at  DateTime @default(dbgenerated("clock_timestamp()")) @db.Timestamptz(6)

  thread MessageThread @relation(fields: [thread_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  author User          @relation(fields: [author_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([thread_id, created_at], map: "messages_thread_idx")
  @@map("messages")
}

model Announcement {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  title        String
  body         String
  audience_all Boolean  @default(false)
  created_by   String   @db.Uuid
  created_at   DateTime @default(now()) @db.Timestamptz(6)

  creator    User                    @relation(fields: [created_by], references: [id], onDelete: NoAction, onUpdate: NoAction)
  targets    AnnouncementTarget[]
  recipients AnnouncementRecipient[]

  @@map("announcements")
}

model AnnouncementTarget {
  announcement_id String @db.Uuid
  kind            String // user, group, role, department
  target_id       String @db.Uuid

  announcement Announcement @relation(fields: [announcement_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@id([announcement_id, kind, target_id])
  @@map("announcement_targets")
}

// Fixed when the announcement is sent.
model AnnouncementRecipient {
  announcement_id String @db.Uuid
  user_id         String @db.Uuid

  announcement Announcement          @relation(fields: [announcement_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  user         User                  @relation(fields: [user_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  response     AnnouncementResponse?

  @@id([announcement_id, user_id])
  @@index([user_id], map: "announcement_recipients_user_idx")
  @@map("announcement_recipients")
}

// Append-only (trigger). A disagreement needs a note of at least 3 characters (check constraint).
model AnnouncementResponse {
  announcement_id String   @db.Uuid
  user_id         String   @db.Uuid
  decision        String // agree, disagree
  note            String?
  responded_at    DateTime @default(now()) @db.Timestamptz(6)

  recipient AnnouncementRecipient @relation(fields: [announcement_id, user_id], references: [announcement_id, user_id], onDelete: Cascade, onUpdate: NoAction)

  @@id([announcement_id, user_id])
  @@map("announcement_responses")
}

// ---------------------------------------------------------------------------------------------------------------------
// Register framework (migration 0019). Written only through the reg_* functions; scalar foreign keys, no back-relations.
// ---------------------------------------------------------------------------------------------------------------------
model RegisterDefinition {
  register_key      String   @id
  name_en           String
  name_ar           String?
  module_key        String
  kind              String   @default("register")
  site_scoped       Boolean  @default(true)
  multiple_per_site Boolean  @default(true)
  record_types      String[]
  approval_levels   Int      @default(3) // the level count of the register's Matrix row (1..3)
  rules             Json     @default("{}") @db.JsonB
  enabled           Boolean  @default(false)
  sort_order        Int      @default(0)
  is_active         Boolean  @default(true)

  @@map("register_definitions")
}

model RegisterField {
  register_key String
  code         String
  label_en     String
  label_ar     String?
  field_type   String
  required     Boolean @default(false)
  is_actual    Boolean @default(false)
  derived      Boolean @default(false)
  options      Json?   @db.JsonB
  in_list      Boolean @default(false)
  section      String?
  sort_order   Int     @default(0)
  is_active    Boolean @default(true)

  @@id([register_key, code])
  @@map("register_fields")
}

model RegisterTaskSource {
  register_key String
  task_code    String
  date_field   String
  data_eq      Json    @default("{}") @db.JsonB
  data_in      Json    @default("{}") @db.JsonB
  sort_order   Int     @default(0)
  is_active    Boolean @default(true)

  @@id([register_key, task_code])
  @@map("register_task_sources")
}

model RegisterRecord {
  id                    String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  entity_id             String    @db.Uuid
  version_no            Int       @default(1)
  supersedes_id         String?   @db.Uuid
  is_current            Boolean   @default(false)
  register_key          String
  record_type           String?
  site_id               String?   @db.Uuid
  region_id             Int?
  is_global             Boolean   @default(false)
  state                 String    @default("entry")
  current_level         Int       @default(1)
  levels_required       Int       @default(3)
  path_frozen_at        DateTime? @db.Timestamptz(6)
  level_round           Int       @default(0)
  level_opened_at       DateTime? @db.Timestamptz(6)
  ball_in_court_user_id String?   @db.Uuid
  return_count          Int       @default(0)
  last_return_note      String?
  self_approval         Boolean   @default(false)
  task_id               String?   @db.Uuid
  data                  Json      @default("{}") @db.JsonB
  custom                Json      @default("{}") @db.JsonB
  external_party_id     String?   @db.Uuid
  source                String    @default("manual")
  batch_row_id          String?   @db.Uuid
  version               Int       @default(1)
  created_by            String?   @db.Uuid
  created_at            DateTime  @default(now()) @db.Timestamptz(6)
  updated_at            DateTime  @default(now()) @db.Timestamptz(6)
  submitted_at          DateTime? @db.Timestamptz(6)
  approved_at           DateTime? @db.Timestamptz(6)
  approved_by           String?   @db.Uuid
  voided_at             DateTime? @db.Timestamptz(6)
  voided_by             String?   @db.Uuid
  void_reason           String?

  @@unique([entity_id, version_no], map: "register_records_version_key")
  @@index([register_key, site_id])
  @@map("register_records")
}

model RegisterStep {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  record_id       String   @db.Uuid
  level           Int
  action          String
  acted_by        String?  @db.Uuid
  note            String?
  before_state    String?
  after_state     String?
  stepup_verified Boolean  @default(false)
  self_approval   Boolean  @default(false)
  batch_row_id    String?  @db.Uuid
  created_at      DateTime @default(now()) @db.Timestamptz(6)

  @@index([record_id, created_at])
  @@map("register_steps")
}

model RegisterLevelActor {
  record_id String   @db.Uuid
  level     Int
  user_id   String   @db.Uuid
  how       String
  acted_at  DateTime @default(now()) @db.Timestamptz(6)

  @@id([record_id, level])
  @@map("register_level_actors")
}

model RegisterLevelVoter {
  record_id String    @db.Uuid
  level     Int
  round     Int
  user_id   String    @db.Uuid
  voted_at  DateTime? @db.Timestamptz(6)

  @@id([record_id, level, round, user_id])
  @@map("register_level_voters")
}
