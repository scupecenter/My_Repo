// GSDN PMIS - Prisma schema (PostgreSQL 16)
// Migrations only: never hand-edit the database. Raw SQL (append-only trigger, RLS) lives in db/sql/ and is
// applied through a Prisma migration (prisma migrate dev --create-only, then paste the SQL file).
// Field names are snake_case on purpose: they match db/sql, the importer mapping.csv and the API contract.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================================================
// ENUMS
// ============================================================================

enum UserStatus {
  pending_assignment
  active
  suspended
  disabled
}

enum PermissionLevel {
  view
  entry
  review
  approve
  admin
}

enum TeamKind {
  cw
  te
  both
  none
}

enum DelegationScope {
  full
  partial
}

enum DeliveryScenario {
  new_build
  expansion
  hot_swap
  cold_swap
  relocation
}

enum OverallStatus {
  not_started
  in_progress
  on_hold
  completed
  cancelled
}

enum ScopeFlag {
  yes
  na
}

enum TaskState {
  locked
  open
  entry
  in_review
  in_approval
  approved
  rejected
  na
  skipped
  suspended
}

enum WorkflowAction {
  submit
  approve
  reject
  auto_skip
  claim
  release
  reassign
  admin_override
  reopen
}

enum MatrixRule {
  any_one
  all_members
}

enum AssigneeKind {
  user
  role
  sub_role
  group
}

enum DocKind {
  scanned_document
  photo
  email
  report
  excel_template
}

enum DocPlacementKind {
  task
  qc
  register
}

enum DocStatus {
  missing
  uploaded
  in_review
  approved
  rejected
}

enum AppliesTo {
  new_tasks_only
  open_tasks_too
}

enum SnagStatus {
  open
  fix_uploaded
  in_review
  closed
  cancelled
}

enum GeofenceResult {
  inside
  outside
  no_gps
  not_checked
}

enum BatchStatus {
  uploaded
  validated
  in_review
  partially_approved
  approved
  rejected
  failed
}

enum RowAction {
  create
  update
  unchanged
  error
}

enum RowDecision {
  pending
  approved
  rejected
}

enum ChangeKind {
  scope_change
  date_change
  suspension
  resumption
  other
}

enum ChangeStatus {
  requested
  approved
  rejected
  applied
}

enum WeightSetCode {
  project_status
  health_index
  delay_attribution
}

enum WeightSetStatus {
  draft
  published
}

enum FieldEntityType {
  site
  task_instance
  rf_design
  acquisition
  procurement
  gecol
  hlc
  permit
  warehouse_item
  warehouse_serial
  quality
  issue
  risk
  change_request
  readiness
  as_built
  meeting
  external_party
}

enum FieldDataType {
  text
  number
  date
  list
  multi_list
  bool
  user
  external_party
  file
}

enum FieldAccess {
  hidden
  read
  edit
}

enum PermissionAction {
  view
  create
  edit
  delete
  approve
  export
  import
  download_documents
  view_audit
  administer
}

enum LogLevel {
  debug
  info
  warn
  error
}

enum NotifyChannel {
  in_app
  email
}

enum RegisterStatus {
  open
  in_progress
  closed
  na
}

enum ExternalPartyType {
  cw_contractor
  te_vendor
  gecol
  hlc
  supplier
  landlord
  other
}

// ============================================================================
// 1. IDENTITY, ROLES, ACCESS
// ============================================================================

model Region {
  id      Int     @id // fixed ids 1..7 so RLS can compare integers
  code    String  @unique // Tripoli, Middle, WM, Zawia, Benghazi, GM, Sebha
  name_en String
  name_ar String?

  sites                    Site[]
  UserRoleAssignmentRegion UserRoleAssignmentRegion[]
  SlaRule                  SlaRule[]
  ProgressSnapshot         ProgressSnapshot[]

  @@map("regions")
}

model Role {
  id        String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code      String  @unique
  name_en   String
  name_ar   String?
  sort      Int     @default(0)
  is_active Boolean @default(true)

  sub_roles          SubRole[]
  UserRoleAssignment UserRoleAssignment[]
  FieldPermission    FieldPermission[]

  @@map("roles")
}

model SubRole {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  role_id   String   @db.Uuid
  code      String   @unique
  name_en   String
  name_ar   String?
  team      TeamKind @default(none)
  is_active Boolean  @default(true)

  role               Role                 @relation(fields: [role_id], references: [id])
  UserRoleAssignment UserRoleAssignment[]

  @@index([role_id])
  @@map("sub_roles")
}

model User {
  id              String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  m365_object_id  String     @unique // Entra ID oid claim
  email           String     @unique
  display_name    String
  employee_id     String?    @unique @db.Char(4) // 4-digit, entered at first sign-in
  status          UserStatus @default(pending_assignment)
  locale          String     @default("en")
  theme           String     @default("light")
  is_break_glass  Boolean    @default(false)
  totp_secret_enc String? // break-glass admin only, encrypted
  last_login_at   DateTime?  @db.Timestamptz(6)
  created_at      DateTime   @default(now()) @db.Timestamptz(6)
  updated_at      DateTime   @updatedAt @db.Timestamptz(6)

  // Role, sub-role, permission level, team, regions and modules live on the assignments (many-to-many).
  // There is deliberately no user-level default: effective access is the union of the active assignments.
  assignments      UserRoleAssignment[]
  assigned_by_me   UserRoleAssignment[] @relation("AssignmentAssignedBy")
  group_members    GroupMember[]
  delegations_from Delegation[]         @relation("DelegationFrom")
  delegations_to   Delegation[]         @relation("DelegationTo")

  @@index([status])
  @@map("users")
}

// One row = one person holding one role OR one sub-role, with its own level, scope and validity.
// Exactly one of role_id / sub_role_id is set (CHECK in migration 0004). A person can hold many rows.
model UserRoleAssignment {
  id               String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id          String          @db.Uuid
  role_id          String?         @db.Uuid
  sub_role_id      String?         @db.Uuid
  permission_level PermissionLevel @default(view)
  team             TeamKind        @default(none)
  valid_from       DateTime        @default(now()) @db.Timestamptz(6)
  valid_to         DateTime?       @db.Timestamptz(6) // null = until removed
  all_regions      Boolean         @default(false) // explicit opt-in to every region; false + no region rows = no regions
  all_modules      Boolean         @default(false) // explicit opt-in to every module
  is_primary       Boolean         @default(false) // at most one per user (partial unique index, migration 0004)
  assigned_by      String?         @db.Uuid
  assigned_at      DateTime        @default(now()) @db.Timestamptz(6)

  user                      User                        @relation(fields: [user_id], references: [id], onDelete: Cascade)
  role                      Role?                       @relation(fields: [role_id], references: [id])
  sub_role                  SubRole?                    @relation(fields: [sub_role_id], references: [id])
  assigner                  User?                       @relation("AssignmentAssignedBy", fields: [assigned_by], references: [id])
  regions                   UserRoleAssignmentRegion[]
  modules                   UserRoleAssignmentModule[]
  UserRoleAssignmentProfile UserRoleAssignmentProfile[]

  @@index([user_id, valid_to])
  @@index([role_id])
  @@index([sub_role_id])
  @@map("user_role_assignments")
}

// Scope is explicit: rows here, or all_regions = true on the assignment. No rows and all_regions = false gives no access
// (a deferred constraint trigger refuses to commit such an active assignment).
model UserRoleAssignmentRegion {
  assignment_id String             @db.Uuid
  region_id     Int
  assignment    UserRoleAssignment @relation(fields: [assignment_id], references: [id], onDelete: Cascade)
  region        Region             @relation(fields: [region_id], references: [id])

  @@id([assignment_id, region_id])
  @@index([region_id])
  @@map("user_role_assignment_regions")
}

// Rows here, or all_modules = true on the assignment; otherwise no modules.
model UserRoleAssignmentModule {
  assignment_id String             @db.Uuid
  module_key    String // sites, procurement, contractors, gecol, hlc, permits_hse, warehouse, quality, issues, risks, change_control, readiness, as_built, meetings, templates, reports
  assignment    UserRoleAssignment @relation(fields: [assignment_id], references: [id], onDelete: Cascade)

  @@id([assignment_id, module_key])
  @@map("user_role_assignment_modules")
}

model Group {
  id               String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name             String   @unique
  description      String?
  is_system_admins Boolean  @default(false) // the System Admins group
  is_active        Boolean  @default(true)
  created_at       DateTime @default(now()) @db.Timestamptz(6)

  members GroupMember[]

  @@map("groups")
}

model GroupMember {
  group_id String   @db.Uuid
  user_id  String   @db.Uuid
  added_at DateTime @default(now()) @db.Timestamptz(6)
  group    Group    @relation(fields: [group_id], references: [id], onDelete: Cascade)
  user     User     @relation(fields: [user_id], references: [id])

  @@id([group_id, user_id])
  @@index([user_id])
  @@map("group_members")
}

model Delegation {
  id           String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  from_user_id String          @db.Uuid
  to_user_id   String          @db.Uuid
  scope        DelegationScope
  permissions  Json? // for partial: list of rights, e.g. ["approve","matrix.edit"]
  valid_from   DateTime        @db.Timestamptz(6)
  valid_to     DateTime?       @db.Timestamptz(6) // null = until revoked
  revoked      Boolean         @default(false)
  revoked_at   DateTime?       @db.Timestamptz(6)
  revoked_by   String?         @db.Uuid
  reason       String?
  created_at   DateTime        @default(now()) @db.Timestamptz(6)

  from_user User @relation("DelegationFrom", fields: [from_user_id], references: [id])
  to_user   User @relation("DelegationTo", fields: [to_user_id], references: [id])

  @@index([to_user_id, revoked])
  @@map("delegations")
}

// ============================================================================
// 2. SITES AND CLUSTERS
// ============================================================================

model Cluster {
  id                  String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  cluster_code        String    @unique // Master G / EN
  name                String?
  region_id           Int?
  is_global           Boolean   @default(false) // explicit global row; NULL region alone never means global
  kpi_acceptance_date DateTime? @db.Date // recorded once per cluster, applied to all sites
  kpi_source_date     DateTime? @db.Date
  kpi_validated       Boolean   @default(false)

  sites Site[]

  @@map("clusters")
}

model Site {
  id                      String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  site_code               String            @unique // Master B Site ID
  owner_site_id           String? // Master C
  name                    String
  region_id               Int
  sub_region              String?
  cluster_id              String?           @db.Uuid
  latitude                Decimal?          @db.Decimal(9, 6)
  longitude               Decimal?          @db.Decimal(9, 6)
  address                 String?
  site_type               String?
  site_scenario           String? // Master K, RF classification
  uplink_site             String?
  tower_owner             String?
  existing_or_new         String?
  rt_or_gf                String?
  tower_type              String?
  tower_height_m          Decimal?          @db.Decimal(6, 1)
  config_summary          String? // WL/MW/IP/PWR text (computed in Master)
  rf_survey_date          DateTime?         @db.Date
  acquisition_date        DateTime?         @db.Date
  project_phase           String?
  delivery_batch          String?
  delivery_scenario       DeliveryScenario?
  cw_delivery_model       String? // outsourced / internal
  // Scope flags (Master AA:AF)
  scope_tower_erection    ScopeFlag         @default(na)
  scope_site_adaption     ScopeFlag         @default(na)
  scope_gecol_power       ScopeFlag         @default(na)
  scope_hlc_fiber         ScopeFlag         @default(na)
  scope_te_full           ScopeFlag         @default(na)
  scope_te_ip_router_only ScopeFlag         @default(na)
  overall_status          OverallStatus     @default(not_started)
  current_milestone       String?
  next_milestone          String?
  is_active               Boolean           @default(true)
  created_at              DateTime          @default(now()) @db.Timestamptz(6)
  updated_at              DateTime          @updatedAt @db.Timestamptz(6)

  region               Region                 @relation(fields: [region_id], references: [id])
  cluster              Cluster?               @relation(fields: [cluster_id], references: [id])
  tasks                TaskInstance[]
  Snag                 Snag[]
  DocumentSlot         DocumentSlot[]
  BaselineEntry        BaselineEntry[]
  ChangeRequest        ChangeRequest[]
  RfDesignRecord       RfDesignRecord[]
  AcquisitionCandidate AcquisitionCandidate[]
  ProcurementRecord    ProcurementRecord[]
  GecolRecord          GecolRecord[]
  HlcRecord            HlcRecord[]
  PermitRecord         PermitRecord[]
  WarehouseSerial      WarehouseSerial[]
  WarehouseSiteQty     WarehouseSiteQty[]
  QualityInspection    QualityInspection[]
  Issue                Issue[]
  ReadinessHandover    ReadinessHandover[]
  AsBuiltRecord        AsBuiltRecord[]
  custom               Json                   @default("{}") @db.JsonB // admin-defined fields, validated by trigger

  @@unique([id, region_id]) // target of composite FKs (site_id, region_id)
  @@index([region_id, overall_status])
  @@index([cluster_id])
  @@index([delivery_scenario])
  @@index([project_phase, delivery_batch])
  @@index([custom], type: Gin)
  @@map("sites")
}

// ============================================================================
// 3. STAGES, TASKS, WORKFLOW, MATRIX
// ============================================================================

model StageDefinition {
  id              String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code            String  @unique // S01..S10 (10 milestones)
  seq             Int     @unique
  name_en         String
  name_ar         String?
  milestone_name  String // Site Release, PRE-CW Completion, ...
  approval_levels Int     @default(3) // configurable per stage
  is_protected    Boolean @default(true) // milestones are code-defined: no insert/delete/rename (trigger, migration 0007)
  is_active       Boolean @default(true)

  tasks        TaskDefinition[]
  matrix_cells MatrixCell[]

  @@map("stage_definitions")
}

model TaskDefinition {
  id                      String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code                    String             @unique // immutable; shared with the task catalogue
  stage_id                String             @db.Uuid // a task belongs to a fixed stage and never moves
  sort_order              Int
  name_en                 String
  name_ar                 String?
  has_documents           Boolean            @default(true)
  is_milestone_task       Boolean            @default(false)
  is_protected            Boolean            @default(false) // milestone/gate rows: cannot be deleted, renamed or deactivated
  counts_toward_milestone Boolean            @default(true) // false = does not block the stage milestone
  approval_levels         Int? // null = inherit stage
  condition_rule          Json? // scope-flag / scenario applicability rule
  default_external_party  ExternalPartyType?
  is_active               Boolean            @default(true)
  // versioning (bumped by trigger on every change; before/after values go to audit_log)
  version                 Int                @default(1)
  effective_from          DateTime           @default(now()) @db.Date
  reason                  String?
  changed_by              String?            @db.Uuid
  changed_at              DateTime           @default(now()) @db.Timestamptz(6)

  stage          StageDefinition         @relation(fields: [stage_id], references: [id])
  instances      TaskInstance[]
  matrix_cells   MatrixCell[]
  doc_placements DocumentTypePlacement[]
  SlaRule        SlaRule[]
  predecessors   TaskPredecessor[]       @relation("TaskHasPredecessors")
  successors     TaskPredecessor[]       @relation("TaskIsPredecessorOf")
  field_defs     FieldDefinition[]

  @@index([stage_id, sort_order])
  @@map("task_definitions")
}

// Predecessor links between tasks (any stage). Cycles are rejected by trigger.
model TaskPredecessor {
  task_def_id    String         @db.Uuid
  predecessor_id String         @db.Uuid
  task           TaskDefinition @relation("TaskHasPredecessors", fields: [task_def_id], references: [id], onDelete: Cascade)
  predecessor    TaskDefinition @relation("TaskIsPredecessorOf", fields: [predecessor_id], references: [id])

  @@id([task_def_id, predecessor_id])
  @@index([predecessor_id])
  @@map("task_predecessors")
}

model TaskInstance {
  id                       String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  site_id                  String         @db.Uuid
  region_id                Int // denormalised from site for RLS and filters
  site                     Site           @relation(fields: [site_id, region_id], references: [id, region_id], onUpdate: Cascade)
  task_def_id              String         @db.Uuid
  state                    TaskState      @default(locked)
  current_level            Int            @default(0) // 1 entry, 2 review, 3 approve
  levels_required          Int            @default(3) // frozen at creation
  ball_in_court_user_id    String?        @db.Uuid
  ball_in_court_group_id   String?        @db.Uuid
  ball_in_court_role_id    String?        @db.Uuid
  external_party_id        String?        @db.Uuid
  baseline_date            DateTime?      @db.Date
  planned_date             DateTime?      @db.Date
  planned_start            DateTime?      @db.Date
  actual_start             DateTime?      @db.Date
  actual_date              DateTime?      @db.Date
  submitted_date           DateTime?      @db.Date
  approved_date            DateTime?      @db.Date
  values                   Json? // task-specific extra fields (result, analysis type, status text)
  sla_rule_id              String?        @db.Uuid // snapshot taken when the task opens; re-pointed only by the admin path
  sla_rule                 SlaRule?       @relation(fields: [sla_rule_id], references: [id])
  lock_reason              String?
  is_na                    Boolean        @default(false)
  na_reason                String?
  admin_override           Boolean        @default(false)
  has_override_flag_in_kpi Boolean        @default(false)
  due_date                 DateTime?      @db.Date
  version                  Int            @default(1)
  created_at               DateTime       @default(now()) @db.Timestamptz(6)
  updated_at               DateTime       @updatedAt @db.Timestamptz(6)
  task_def                 TaskDefinition @relation(fields: [task_def_id], references: [id])
  external_party           ExternalParty? @relation(fields: [external_party_id], references: [id])
  steps                    WorkflowStep[]
  slots                    DocumentSlot[]
  comments                 Comment[]
  snags                    Snag[]
  custom                   Json           @default("{}") @db.JsonB // admin-defined fields, validated by trigger

  @@unique([id, region_id])
  @@unique([site_id, task_def_id])
  @@index([region_id, state])
  @@index([state, ball_in_court_user_id])
  @@index([ball_in_court_group_id, state])
  @@index([ball_in_court_role_id, state])
  @@index([task_def_id, state])
  @@index([sla_rule_id])
  @@index([due_date])
  @@index([custom], type: Gin)
  @@map("task_instances")
}

model WorkflowStep {
  id              String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  task_id         String         @db.Uuid
  level           Int
  action          WorkflowAction
  holder_user_id  String?        @db.Uuid // resolved holder at that time
  holder_group_id String?        @db.Uuid
  acted_by        String?        @db.Uuid
  on_behalf_of    String?        @db.Uuid // delegation: "X on behalf of System Admin"
  claimed_by      String?        @db.Uuid
  note            String? // mandatory on reject
  admin_override  Boolean        @default(false)
  override_reason String?
  stepup_verified Boolean        @default(false)
  batch_row_id    String?        @db.Uuid
  before_state    TaskState?
  after_state     TaskState?
  created_at      DateTime       @default(now()) @db.Timestamptz(6)

  task TaskInstance @relation(fields: [task_id], references: [id], onDelete: Cascade)

  @@index([task_id, created_at])
  @@index([acted_by])
  @@map("workflow_steps")
}

// Responsibility Matrix: stage or task x level -> assignees. task_def_id null = stage default.
model MatrixCell {
  id          String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  stage_id    String     @db.Uuid
  task_def_id String?    @db.Uuid
  level       Int // 1 entry, 2 review, 3 approve
  rule        MatrixRule @default(any_one)
  region_id   Int? // optional region-specific cell
  is_global   Boolean    @default(false) // explicit global row; NULL region alone never means global
  updated_by  String?    @db.Uuid
  updated_at  DateTime   @updatedAt @db.Timestamptz(6)

  stage     StageDefinition      @relation(fields: [stage_id], references: [id])
  task_def  TaskDefinition?      @relation(fields: [task_def_id], references: [id])
  assignees MatrixCellAssignee[]

  @@unique([stage_id, task_def_id, level, region_id])
  @@index([stage_id, level])
  @@map("matrix_cells")
}

model MatrixCellAssignee {
  id      String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  cell_id String       @db.Uuid
  kind    AssigneeKind
  ref_id  String       @db.Uuid // user / role / sub_role / group id according to kind
  cell    MatrixCell   @relation(fields: [cell_id], references: [id], onDelete: Cascade)

  @@unique([cell_id, kind, ref_id])
  @@index([kind, ref_id])
  @@map("matrix_cell_assignees")
}

// Vendors, contractors, GECOL, HLC, suppliers: never log in, shown on tasks for delay attribution.
model ExternalParty {
  id             String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name           String            @unique
  type           ExternalPartyType
  company_type   String?
  contract_ref   String?
  contract_start DateTime?         @db.Date
  contract_end   DateTime?         @db.Date
  is_active      Boolean           @default(true)

  tasks TaskInstance[]
  teams ExternalTeam[]

  custom Json @default("{}") @db.JsonB // admin-defined fields, validated by trigger

  @@index([custom], type: Gin)
  @@map("external_parties")
}

model ExternalTeam {
  id             String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  party_id       String        @db.Uuid
  name           String
  team_type      String?
  specialization String?
  is_active      Boolean       @default(true)
  party          ExternalParty @relation(fields: [party_id], references: [id])

  @@unique([party_id, name])
  @@map("external_teams")
}

// ============================================================================
// 4. DOCUMENT LIBRARY, SLOTS, FILES
// ============================================================================

model DocumentType {
  id                 String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code               String    @unique // A1, A2, B1 ...
  name_en            String
  name_ar            String?
  kind               DocKind   @default(scanned_document)
  is_mandatory       Boolean   @default(true)
  condition_rule     Json? // when conditional, e.g. {"all":[{"site.scope_tower_erection":"yes"}]}
  formats            String[]  @default(["pdf", "jpg", "jpeg", "png"])
  max_size_mb        Int       @default(20)
  min_files          Int       @default(1)
  max_files          Int? // null = unlimited
  photo_rules        Json? // required shot types, min count, EXIF rule
  has_expiry         Boolean   @default(false)
  expiry_field       String?
  blank_form_file_id String?   @db.Uuid
  applies_to         AppliesTo @default(new_tasks_only)
  is_active          Boolean   @default(true) // deactivated, never deleted
  version            Int       @default(1)
  created_at         DateTime  @default(now()) @db.Timestamptz(6)
  updated_at         DateTime  @updatedAt @db.Timestamptz(6)

  placements DocumentTypePlacement[]
  slots      DocumentSlot[]

  @@map("document_types")
}

model DocumentTypePlacement {
  id           String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  doc_type_id  String           @db.Uuid
  kind         DocPlacementKind
  task_def_id  String?          @db.Uuid
  snag_type_id String?          @db.Uuid
  register_key String? // e.g. permits_hse, procurement

  doc_type  DocumentType    @relation(fields: [doc_type_id], references: [id])
  task_def  TaskDefinition? @relation(fields: [task_def_id], references: [id])
  snag_type SnagType?       @relation(fields: [snag_type_id], references: [id])

  @@index([doc_type_id])
  @@index([task_def_id])
  @@map("document_type_placements")
}

model DocumentSlot {
  id              String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  task_id         String?   @db.Uuid
  site_id         String    @db.Uuid
  region_id       Int
  site            Site      @relation(fields: [site_id, region_id], references: [id, region_id], onUpdate: Cascade)
  doc_type_id     String    @db.Uuid
  candidate_label String? // e.g. each SAR candidate
  status          DocStatus @default(missing)
  reject_reason   String?
  valid_to        DateTime? @db.Date // expiry
  created_at      DateTime  @default(now()) @db.Timestamptz(6)

  task     TaskInstance?  @relation(fields: [task_id], references: [id])
  doc_type DocumentType   @relation(fields: [doc_type_id], references: [id])
  files    DocumentFile[]

  @@index([task_id])
  @@index([site_id, doc_type_id])
  @@index([region_id, status])
  @@map("document_slots")
}

// Superseded versions are kept: (slot_id, file_group_id, version).
model DocumentFile {
  id            String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  slot_id       String    @db.Uuid
  file_group_id String    @db.Uuid // same logical file across versions
  version       Int       @default(1)
  is_current    Boolean   @default(true)
  original_name String
  stored_name   String // SITE_TASK_DOC_APPROVEDDATE.ext
  storage_key   String // MinIO object key
  mime_type     String
  size_bytes    BigInt
  sha256        String
  uploaded_by   String    @db.Uuid
  uploaded_at   DateTime  @default(now()) @db.Timestamptz(6)
  approved_date DateTime? @db.Date

  slot DocumentSlot @relation(fields: [slot_id], references: [id])

  @@unique([file_group_id, version])
  @@index([slot_id, is_current])
  @@index([sha256])
  @@map("document_files")
}

// ============================================================================
// 5. QC SNAGS AND PHOTO EVIDENCE
// ============================================================================

model SnagType {
  id                            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code                          String   @unique
  name_en                       String
  name_ar                       String?
  min_photos                    Int      @default(1)
  required_shots                Json? // ["before","after","wide"]
  formats                       String[] @default(["jpg", "png", "heic"])
  max_size_mb                   Int      @default(20)
  blocks_preliminary_acceptance Boolean  @default(true)
  is_active                     Boolean  @default(true)

  snags          Snag[]
  doc_placements DocumentTypePlacement[]

  @@map("snag_types")
}

model Snag {
  id                   String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  site_id              String        @db.Uuid
  region_id            Int
  site                 Site          @relation(fields: [site_id, region_id], references: [id, region_id], onUpdate: Cascade)
  task_id              String?       @db.Uuid // task whose approval it blocks
  snag_type_id         String        @db.Uuid
  scope                String // CW or TE
  stage_ref            String? // CW PAC, TE PAC, CW FAC, TE FAC
  description          String
  severity             String?
  status               SnagStatus    @default(open)
  raised_by            String        @db.Uuid
  raised_at            DateTime      @default(now()) @db.Timestamptz(6)
  target_date          DateTime?     @db.Date
  closed_at            DateTime?     @db.Timestamptz(6)
  closed_by            String?       @db.Uuid
  responsible_party_id String?       @db.Uuid
  task                 TaskInstance? @relation(fields: [task_id], references: [id])
  snag_type            SnagType      @relation(fields: [snag_type_id], references: [id])
  photos               SnagPhoto[]

  @@index([site_id, status])
  @@index([region_id, status])
  @@index([task_id, status])
  @@map("snags")
}

model SnagPhoto {
  id                   String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  snag_id              String         @db.Uuid
  shot_type            String?
  storage_key          String
  mime_type            String
  size_bytes           BigInt
  sha256               String
  exif_date            DateTime?      @db.Timestamptz(6)
  unknown_capture_date Boolean        @default(false)
  before_snag_raised   Boolean        @default(false) // rejected when true
  gps_lat              Decimal?       @db.Decimal(9, 6)
  gps_lon              Decimal?       @db.Decimal(9, 6)
  distance_m           Decimal?       @db.Decimal(9, 1)
  geofence_result      GeofenceResult @default(not_checked)
  geofence_radius_m    Int            @default(300)
  captured_in_app      Boolean        @default(false)
  stamp_meta           Json? // site id, name, address, coordinates, engineer, task
  uploaded_by          String         @db.Uuid
  uploaded_at          DateTime       @default(now()) @db.Timestamptz(6)
  review_note          String?

  snag Snag @relation(fields: [snag_id], references: [id], onDelete: Cascade)

  @@index([snag_id])
  @@index([geofence_result])
  @@map("snag_photos")
}

// ============================================================================
// 6. TEMPLATES AND IMPORT BATCHES
// ============================================================================

model TemplateDefinition {
  id               String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  template_id      String  @unique // embedded in hidden sheet _tpl
  name             String
  target_entity    String // sites, task_dates, procurement ...
  is_master_format Boolean @default(false)
  is_active        Boolean @default(true)

  versions TemplateVersion[]

  @@map("template_definitions")
}

model TemplateVersion {
  id                String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  template_def_id   String   @db.Uuid
  version           Int
  header_checksum   String // sha256 of the header row; mismatch rejects the upload
  field_set_version Int      @default(1) // field_set_versions.version of the target entity when built; older = rejected on upload
  columns           Json // ordered column spec and validation
  storage_key       String?
  is_current        Boolean  @default(true)
  published_by      String?  @db.Uuid
  published_at      DateTime @default(now()) @db.Timestamptz(6)

  template TemplateDefinition @relation(fields: [template_def_id], references: [id])
  batches  ImportBatch[]

  @@unique([template_def_id, version])
  @@map("template_versions")
}

model ImportBatch {
  id                  String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  template_version_id String      @db.Uuid
  source              String      @default("upload") // upload, master_import
  file_name           String
  file_sha256         String
  status              BatchStatus @default(uploaded)
  uploaded_by         String      @db.Uuid
  region_scope        Int[] // regions touched, for RLS
  rows_total          Int         @default(0)
  rows_error          Int         @default(0)
  approve_mode        String? // row_by_row or all_at_once
  created_at          DateTime    @default(now()) @db.Timestamptz(6)
  approved_at         DateTime?   @db.Timestamptz(6)

  template_version TemplateVersion  @relation(fields: [template_version_id], references: [id])
  rows             ImportBatchRow[]

  @@index([status, created_at])
  @@index([uploaded_by])
  @@map("import_batches")
}

model ImportBatchRow {
  id            String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  batch_id      String      @db.Uuid
  row_no        Int
  site_code     String?
  region_id     Int?
  target_entity String
  target_id     String?     @db.Uuid
  action        RowAction   @default(create)
  payload       Json // parsed row
  diff          Json? // field -> {old, new}
  errors        Json?
  decision      RowDecision @default(pending)
  decided_by    String?     @db.Uuid
  decided_at    DateTime?   @db.Timestamptz(6)
  decision_note String?

  batch ImportBatch @relation(fields: [batch_id], references: [id], onDelete: Cascade)

  @@unique([batch_id, row_no])
  @@index([batch_id, decision])
  @@index([site_code])
  @@map("import_batch_rows")
}

// ============================================================================
// 7. COMMENTS, NOTIFICATIONS, HOLIDAYS, BASELINE, CHANGE CONTROL
// ============================================================================

model Comment {
  id                String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  task_id           String?       @db.Uuid
  region_id         Int // from the task (composite FK) or the register row
  entity_type       String? // for register records
  entity_id         String?       @db.Uuid
  author_id         String        @db.Uuid
  body              String
  is_rejection_note Boolean       @default(false)
  created_at        DateTime      @default(now()) @db.Timestamptz(6)
  task              TaskInstance? @relation(fields: [task_id, region_id], references: [id, region_id], onUpdate: Cascade, onDelete: Cascade)

  @@index([task_id, created_at])
  @@index([entity_type, entity_id])
  @@map("comments")
}

model Notification {
  id         String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id    String        @db.Uuid
  channel    NotifyChannel @default(in_app)
  kind       String // assigned, rejected, overdue, delegation ...
  title      String
  body       String?
  task_id    String?       @db.Uuid
  link       String?
  read_at    DateTime?     @db.Timestamptz(6)
  sent_at    DateTime?     @db.Timestamptz(6)
  created_at DateTime      @default(now()) @db.Timestamptz(6)

  @@index([user_id, read_at])
  @@index([channel, sent_at])
  @@map("notifications")
}

// Weekend days per calendar (0 = Sunday ... 6 = Saturday). Default: Friday and Saturday (NETWORKDAYS.INTL code 7).
model WorkCalendar {
  id           String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code         String  @unique
  name         String
  weekend_days Int[]   @default([5, 6])
  is_default   Boolean @default(false) // exactly one default (partial unique index, migration 0005)
  is_active    Boolean @default(true)

  holidays  Holiday[]
  sla_rules SlaRule[]

  @@map("work_calendars")
}

model Holiday {
  id          String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  calendar_id String       @db.Uuid
  date        DateTime     @db.Date
  name        String
  calendar    WorkCalendar @relation(fields: [calendar_id], references: [id])

  @@unique([calendar_id, date])
  @@map("holidays")
}

// Versioned SLA rule. min = target (green), max = limit (above = late), counted in working days of the calendar from
// start_event (a task code, milestone code S01..S10 or gate code). Scenario/region NULL = applies to all.
// Overlap of effective ranges for the same task+scenario+region is rejected by an exclusion constraint (migration 0005).
// Edits create a new row; a rule referenced by task instances is immutable apart from effective_to.
model SlaRule {
  id               String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  task_def_id      String            @db.Uuid
  min_working_days Int
  max_working_days Int
  start_event      String
  scenario         DeliveryScenario?
  region_id        Int?
  calendar_id      String            @db.Uuid
  effective_from   DateTime          @db.Date
  effective_to     DateTime?         @db.Date // exclusive; null = open ended
  reason           String
  changed_by       String            @db.Uuid
  changed_at       DateTime          @default(now()) @db.Timestamptz(6)

  task_def  TaskDefinition @relation(fields: [task_def_id], references: [id])
  region    Region?        @relation(fields: [region_id], references: [id])
  calendar  WorkCalendar   @relation(fields: [calendar_id], references: [id])
  instances TaskInstance[]

  @@index([task_def_id, effective_from])
  @@index([region_id])
  @@map("sla_rules")
}

model BaselineVersion {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  version     Int       @unique
  label       String?
  status      String    @default("draft") // draft, approved, superseded
  approved_by String?   @db.Uuid
  approved_at DateTime? @db.Timestamptz(6)
  created_at  DateTime  @default(now()) @db.Timestamptz(6)

  entries BaselineEntry[]

  @@map("baseline_versions")
}

// Baseline date per site per milestone (10 milestones).
model BaselineEntry {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  version_id     String    @db.Uuid
  site_id        String    @db.Uuid
  region_id      Int
  site           Site      @relation(fields: [site_id, region_id], references: [id, region_id], onUpdate: Cascade)
  milestone_code String // S01..S10
  baseline_date  DateTime? @db.Date
  planned_start  DateTime? @db.Date

  version BaselineVersion @relation(fields: [version_id], references: [id])

  @@unique([version_id, site_id, milestone_code])
  @@index([site_id])
  @@index([region_id])
  @@map("baseline_entries")
}

// Min/max working-day gap between consecutive milestones (Baseline sheet Link/From/To/Min/Max).
model PhaseGateRule {
  id             String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  link_code      String  @unique // B01..B09
  is_protected   Boolean @default(true) // fixed: no insert/delete/rename
  from_milestone String
  to_milestone   String
  min_wd         Int
  max_wd         Int

  @@map("phase_gate_rules")
}

// Change Control register: scope/date changes plus Suspension -> Resumption pairs that shift gates.
model ChangeRequest {
  id                 String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  change_code        String       @unique // Master "Change ID"
  site_id            String?      @db.Uuid
  region_id          Int?
  is_global          Boolean      @default(false) // explicit global row; NULL region alone never means global
  site               Site?        @relation(fields: [site_id, region_id], references: [id, region_id], onUpdate: Cascade, onDelete: Restrict)
  kind               ChangeKind
  scope_item         String?
  old_value          String?
  new_value          String?
  reason             String?
  request_date       DateTime?    @db.Date
  status             ChangeStatus @default(requested)
  approved_by        String?      @db.Uuid
  approval_date      DateTime?    @db.Date
  ticket_id          String?
  requested_by       String       @db.Uuid
  // Suspension / resumption
  suspension_start   DateTime?    @db.Date
  resumption_date    DateTime?    @db.Date
  paired_change_id   String?      @db.Uuid
  shift_working_days Int? // computed on resumption, applied to gates
  custom             Json         @default("{}") @db.JsonB // admin-defined fields, validated by trigger

  @@index([site_id, kind])
  @@index([region_id, status])
  @@index([custom], type: Gin)
  @@map("change_requests")
}

// ============================================================================
// 7b. WEIGHT SETS AND PROGRESS SNAPSHOTS (editable Project Status, health index, delay attribution)
// ============================================================================

// Versioned. A published set is immutable (children frozen by trigger) and its effective range cannot overlap another
// published set of the same code. The 100% rule (activities in a set, items in an activity) is enforced at commit by a
// deferred constraint trigger for published sets (db/sql/005_weights.sql).
model WeightSet {
  id             String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code           WeightSetCode
  version        Int
  effective_from DateTime        @db.Date
  effective_to   DateTime?       @db.Date // exclusive
  status         WeightSetStatus @default(draft)
  reason         String
  changed_by     String          @db.Uuid
  created_at     DateTime        @default(now()) @db.Timestamptz(6)
  published_at   DateTime?       @db.Timestamptz(6)

  activities WeightActivity[]
  snapshots  ProgressSnapshot[]

  @@unique([code, version])
  @@index([code, status, effective_from])
  @@map("weight_sets")
}

// Activity (Project Status), factor (health index) or cause (delay attribution).
model WeightActivity {
  id            String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  weight_set_id String  @db.Uuid
  code          String
  name          String
  name_ar       String?
  weight        Decimal @db.Decimal(7, 3) // percent; set total = 100
  sort          Int     @default(0)

  weight_set WeightSet    @relation(fields: [weight_set_id], references: [id], onDelete: Cascade)
  items      WeightItem[]

  @@unique([weight_set_id, code])
  @@map("weight_activities")
}

model WeightItem {
  id           String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  activity_id  String  @db.Uuid
  code         String // e.g. 1.1
  name         String
  name_ar      String?
  weight       Decimal @db.Decimal(7, 3) // percent inside the activity; activity total = 100 (0 allowed = not weighted)
  unit         String? // units, 0/100, one unit per item, ...
  measure_rule Json? // method and source columns (done, applicable, plan basis)
  source       String?
  sort         Int     @default(0)

  activity WeightActivity @relation(fields: [activity_id], references: [id], onDelete: Cascade)

  @@unique([activity_id, code])
  @@map("weight_items")
}

// Weekly snapshot per scope (project-wide = is_global, or one region). Keeps the values computed at the time.
model ProgressSnapshot {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  snapshot_date DateTime @db.Date
  weight_set_id String   @db.Uuid
  region_id     Int?
  is_global     Boolean  @default(false)
  actual_pct    Decimal  @db.Decimal(6, 3)
  planned_pct   Decimal? @db.Decimal(6, 3)
  spi           Decimal? @db.Decimal(6, 3)
  plan_coverage Decimal? @db.Decimal(6, 3)
  health_index  Decimal? @db.Decimal(6, 3)
  values        Json // per activity and item values, factor values, site counts
  created_at    DateTime @default(now()) @db.Timestamptz(6)

  weight_set WeightSet @relation(fields: [weight_set_id], references: [id])
  region     Region?   @relation(fields: [region_id], references: [id])

  @@index([snapshot_date, weight_set_id])
  @@index([region_id, snapshot_date])
  @@map("progress_snapshots")
}

// ============================================================================
// 7c. CUSTOM FIELDS AND PERMISSION GRID (System Admin configuration)
// ============================================================================

// Admin-defined field on a register, sites or tasks. Values live in the entity's `custom` JSONB column keyed by code and are
// validated by trigger (db/sql/006). Fields are deactivated, never deleted once they hold values.
model FieldDefinition {
  id                   String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  entity_type          FieldEntityType
  task_def_id          String?         @db.Uuid // only for entity_type = task_instance: field of one task type
  code                 String
  label_en             String
  label_ar             String?
  data_type            FieldDataType
  required             Boolean         @default(false)
  validation           Json? // {"min":..,"max":..,"min_length":..,"max_length":..,"pattern":".."}
  default_value        Json?
  section              String?
  sort_order           Int             @default(0)
  in_templates         Boolean         @default(false)
  in_exports           Boolean         @default(false)
  master_export_column String? // column letter/name in the Master-format export
  in_list_filters      Boolean         @default(false)
  is_active            Boolean         @default(true)
  version              Int             @default(1)
  effective_from       DateTime        @default(now()) @db.Date
  reason               String?
  changed_by           String?         @db.Uuid
  changed_at           DateTime        @default(now()) @db.Timestamptz(6)

  task_def    TaskDefinition?   @relation(fields: [task_def_id], references: [id])
  list_values FieldListValue[]
  permissions FieldPermission[]

  @@unique([entity_type, code])
  @@index([entity_type, is_active])
  @@map("field_definitions")
}

model FieldListValue {
  id         String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  field_id   String  @db.Uuid
  code       String
  label_en   String
  label_ar   String?
  sort_order Int     @default(0)
  is_active  Boolean @default(true)

  field FieldDefinition @relation(fields: [field_id], references: [id])

  @@unique([field_id, code])
  @@map("field_list_values")
}

// Field x role or permission profile -> hidden / read / edit. No rule = follows the entity-level permission.
// Several rules for one user: the most permissive wins (union).
model FieldPermission {
  id         String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  field_id   String      @db.Uuid
  role_id    String?     @db.Uuid
  profile_id String?     @db.Uuid
  access     FieldAccess

  field   FieldDefinition    @relation(fields: [field_id], references: [id])
  role    Role?              @relation(fields: [role_id], references: [id])
  profile PermissionProfile? @relation(fields: [profile_id], references: [id])

  @@index([field_id])
  @@index([role_id])
  @@index([profile_id])
  @@map("field_permissions")
}

// Per entity type counter bumped by trigger on any field or list change. Template versions record the value they were built at.
model FieldSetVersion {
  entity_type FieldEntityType @id
  version     Int             @default(1)
  updated_at  DateTime        @default(now()) @db.Timestamptz(6)

  @@map("field_set_versions")
}

model PermissionProfile {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code        String   @unique
  name_en     String
  name_ar     String?
  description String?
  is_active   Boolean  @default(true)
  version     Int      @default(1)
  reason      String?
  changed_by  String?  @db.Uuid
  changed_at  DateTime @default(now()) @db.Timestamptz(6)

  grants      PermissionGrant[]
  assignments UserRoleAssignmentProfile[]
  field_perms FieldPermission[]

  @@map("permission_profiles")
}

// Grid cell: profile x module/screen x action. Presence = allowed. module_key is a module ("sites") or screen ("sites.tasks").
model PermissionGrant {
  profile_id String           @db.Uuid
  module_key String
  action     PermissionAction

  profile PermissionProfile @relation(fields: [profile_id], references: [id], onDelete: Cascade)

  @@id([profile_id, module_key, action])
  @@index([module_key])
  @@map("permission_grants")
}

// Profiles applied to assignments (many-to-many). Part of the assignment family (admin-only through the API, no RLS).
model UserRoleAssignmentProfile {
  assignment_id String @db.Uuid
  profile_id    String @db.Uuid

  assignment UserRoleAssignment @relation(fields: [assignment_id], references: [id], onDelete: Cascade)
  profile    PermissionProfile  @relation(fields: [profile_id], references: [id])

  @@id([assignment_id, profile_id])
  @@index([profile_id])
  @@map("user_role_assignment_profiles")
}

// ============================================================================
// 8. REGISTERS (lean; each is its own module)
// ============================================================================

model RfDesignRecord {
  id                        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  site_id                   String    @unique @db.Uuid
  region_id                 Int
  site                      Site      @relation(fields: [site_id, region_id], references: [id, region_id], onUpdate: Cascade)
  nominal_plan_issue_date   DateTime? @db.Date
  nominal_lat               Decimal?  @db.Decimal(9, 6)
  nominal_lon               Decimal?  @db.Decimal(9, 6)
  search_ring_radius_m      Int?
  search_ring_received_date DateTime? @db.Date
  deviation_from_nominal_m  Decimal?  @db.Decimal(9, 1)
  antenna_height_m          Decimal?  @db.Decimal(6, 1)
  sectors                   Int?
  azimuths                  String?
  tilt                      String?
  tss_plan_date             DateTime? @db.Date
  custom                    Json      @default("{}") @db.JsonB // admin-defined fields, validated by trigger

  @@index([region_id])
  @@index([custom], type: Gin)
  @@map("rf_design_records")
}

model AcquisitionCandidate {
  id                    String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  site_id               String    @db.Uuid
  region_id             Int
  site                  Site      @relation(fields: [site_id, region_id], references: [id, region_id], onUpdate: Cascade)
  candidate_no          String
  latitude              Decimal?  @db.Decimal(9, 6)
  longitude             Decimal?  @db.Decimal(9, 6)
  address               String?
  distance_to_nominal_m Decimal?  @db.Decimal(9, 1)
  within_search_ring    Boolean?
  submitted_date        DateTime? @db.Date
  mw_los_check          String?
  test_pit_result       String?
  tss_date              DateTime? @db.Date
  selected              Boolean   @default(false)
  selection_date        DateTime? @db.Date
  owner_name            String?
  ownership_type        String?
  contact_person        String?
  phone                 String?
  email                 String?
  negotiation_start     DateTime? @db.Date
  contract_no           String?
  contract_signoff_date DateTime? @db.Date
