}

// What the calculation layer last saw of each gate on each site (migration 0018, Q81): a gate that was open and is blocked now raises an alert,
// it does not re-lock tasks that are open. Written only by calc_gate_watch. The foreign key to sites (on delete cascade) lives in the migration.
model SiteGateState {
  site_id   String   @db.Uuid
  gate_code String
  is_open   Boolean
  since     DateTime @default(now()) @db.Timestamptz(6)

  @@id([site_id, gate_code])
  @@map("site_gate_state")
}

model BaselineVersion {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  version     Int       @unique
  label       String?
  status      String    @default("draft") // draft, approved, superseded
  approved_by String?   @db.Uuid
  approved_at DateTime? @db.Timestamptz(6)
  created_at  DateTime  @default(now()) @db.Timestamptz(6)

  entries BaselineEntry[]

  @@map("baseline_versions")
}

// Baseline date per site per milestone (10 milestones).
model BaselineEntry {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  version_id     String    @db.Uuid
  site_id        String    @db.Uuid
  region_id      Int
  site           Site      @relation(fields: [site_id, region_id], references: [id, region_id], onUpdate: Cascade)
  milestone_code String // MS1..MS10
  baseline_date  DateTime? @db.Date
  planned_start  DateTime? @db.Date

  version BaselineVersion @relation(fields: [version_id], references: [id])

  @@unique([version_id, site_id, milestone_code])
  @@index([site_id])
  @@index([region_id])
  @@map("baseline_entries")
}

// Min/max working-day gap between consecutive milestones (Baseline sheet Link/From/To/Min/Max).
// Phase gate between two milestones (by stable code). Conditions and SLA are light-editable on a published version.
model PhaseGateRule {
  id                   String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workflow_id          String  @db.Uuid
  link_code            String // G2..G10 in v1; stable (gate Gn sits between MS(n-1) and MSn)
  seq                  Int
  name_en              String
  name_ar              String?
  from_code            String // stage code
  to_code              String // stage code
  conditions           Json? // which tasks, permits or dates the gate waits for
  min_wd               Int // gate SLA
  max_wd               Int
  master_export_column String?
  is_active            Boolean @default(true)

  workflow WorkflowDefinition @relation(fields: [workflow_id], references: [id], onDelete: Cascade)
  custom   Json               @default("{}") @db.JsonB // admin-defined fields, validated by trigger

  @@unique([workflow_id, link_code])
  @@index([custom], type: Gin)
  @@map("phase_gate_rules")
}

// Change Control register: scope/date changes plus Suspension -> Resumption pairs that shift gates.
model ChangeRequest {
  id                 String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  change_code        String       @unique // Master "Change ID"
  site_id            String?      @db.Uuid
  region_id          Int?
  is_global          Boolean      @default(false) // explicit global row; NULL region alone never means global
  site               Site?        @relation(fields: [site_id, region_id], references: [id, region_id], onUpdate: Cascade, onDelete: Restrict)
  kind               ChangeKind
  scope_item         String?
  old_value          String?
  new_value          String?
  reason             String?
  request_date       DateTime?    @db.Date
  status             ChangeStatus @default(requested)
