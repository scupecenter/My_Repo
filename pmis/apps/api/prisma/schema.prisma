  @@index([region_id, status])
  @@index([custom], type: Gin)
  @@map("change_requests")
}

// ============================================================================
// 7b. WEIGHT SETS AND PROGRESS SNAPSHOTS (editable Project Status, health index, delay attribution)
// ============================================================================

// Versioned. A published set is immutable (children frozen by trigger) and its effective range cannot overlap another
// published set of the same code. The 100% rule (activities in a set, items in an activity) is enforced at commit by a
// deferred constraint trigger for published sets (db/sql/005_weights.sql).
model WeightSet {
  id             String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code           WeightSetCode
  version        Int
  effective_from DateTime        @db.Date
  effective_to   DateTime?       @db.Date // exclusive
  status         WeightSetStatus @default(draft)
  reason         String
  changed_by     String          @db.Uuid
  created_at     DateTime        @default(now()) @db.Timestamptz(6)
  published_at   DateTime?       @db.Timestamptz(6)

  activities WeightActivity[]
  snapshots  ProgressSnapshot[]

  @@unique([code, version])
  @@index([code, status, effective_from])
  @@map("weight_sets")
}

// Activity (Project Status), factor (health index) or cause (delay attribution).
model WeightActivity {
  id            String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  weight_set_id String  @db.Uuid
  code          String
  name          String
  name_ar       String?
  weight        Decimal @db.Decimal(7, 3) // percent; set total = 100
  sort          Int     @default(0)

  weight_set WeightSet    @relation(fields: [weight_set_id], references: [id], onDelete: Cascade)
  items      WeightItem[]

  @@unique([weight_set_id, code])
  @@map("weight_activities")
}

model WeightItem {
  id           String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  activity_id  String  @db.Uuid
  code         String // e.g. 1.1
  name         String
  name_ar      String?
  weight       Decimal @db.Decimal(7, 3) // percent inside the activity; activity total = 100 (0 allowed = not weighted)
  unit         String? // units, 0/100, one unit per item, ...
  measure_rule Json? // method and source columns (done, applicable, plan basis)
  source       String?
  sort         Int     @default(0)

  activity WeightActivity @relation(fields: [activity_id], references: [id], onDelete: Cascade)

  @@unique([activity_id, code])
  @@map("weight_items")
}

// Weekly snapshot per scope (project-wide = is_global, or one region). Keeps the values computed at the time.
model ProgressSnapshot {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  snapshot_date DateTime @db.Date
  weight_set_id String   @db.Uuid
  region_id     Int?
  is_global     Boolean  @default(false)
  actual_pct    Decimal  @db.Decimal(6, 3)
  planned_pct   Decimal? @db.Decimal(6, 3)
  spi           Decimal? @db.Decimal(6, 3)
  plan_coverage Decimal? @db.Decimal(6, 3)
  health_index  Decimal? @db.Decimal(6, 3)
  values        Json // per activity and item values, factor values, site counts
  created_at    DateTime @default(now()) @db.Timestamptz(6)

  weight_set WeightSet @relation(fields: [weight_set_id], references: [id])
  region     Region?   @relation(fields: [region_id], references: [id])

  @@index([snapshot_date, weight_set_id])
  @@index([region_id, snapshot_date])
  @@map("progress_snapshots")
}

// ============================================================================
// 7c. CUSTOM FIELDS AND PERMISSION GRID (System Admin configuration)
// ============================================================================

// Admin-defined field on a register, sites or tasks. Values live in the entity's `custom` JSONB column keyed by code and are
// validated by trigger (db/sql/006). Fields are deactivated, never deleted once they hold values.
model FieldDefinition {
  id                   String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  entity_type          FieldEntityType
  task_code            String? // only for entity_type = task_instance: field of one task type (by stable task code)
  code                 String
  label_en             String
  label_ar             String?
  data_type            FieldDataType
  required             Boolean         @default(false)
  validation           Json? // {"min":..,"max":..,"min_length":..,"max_length":..,"pattern":".."}
  default_value        Json?
  section              String?
  sort_order           Int             @default(0)
  in_templates         Boolean         @default(false)
  in_exports           Boolean         @default(false)
  master_export_column String? // column letter/name in the Master-format export
  in_list_filters      Boolean         @default(false)
  is_active            Boolean         @default(true)
  version              Int             @default(1)
  effective_from       DateTime        @default(now()) @db.Date
  reason               String?
  changed_by           String?         @db.Uuid
  changed_at           DateTime        @default(now()) @db.Timestamptz(6)

  list_values FieldListValue[]
  permissions FieldPermission[]

  @@unique([entity_type, code])
  @@index([entity_type, is_active])
  @@map("field_definitions")
}

model FieldListValue {
  id         String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  field_id   String  @db.Uuid
  code       String
  label_en   String
  label_ar   String?
  sort_order Int     @default(0)
  is_active  Boolean @default(true)

  field FieldDefinition @relation(fields: [field_id], references: [id])

  @@unique([field_id, code])
  @@map("field_list_values")
}

// Field x role or permission profile -> hidden / read / edit. No rule = follows the entity-level permission.
// Several rules for one user: the most permissive wins (union).
model FieldPermission {
  id         String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  field_id   String      @db.Uuid
  role_id    String?     @db.Uuid
  profile_id String?     @db.Uuid
  access     FieldAccess

  field   FieldDefinition    @relation(fields: [field_id], references: [id])
  role    Role?              @relation(fields: [role_id], references: [id])
  profile PermissionProfile? @relation(fields: [profile_id], references: [id])

  @@index([field_id])
  @@index([role_id])
  @@index([profile_id])
  @@map("field_permissions")
}

// Per entity type counter bumped by trigger on any field or list change. Template versions record the value they were built at.
model FieldSetVersion {
  entity_type FieldEntityType @id
  version     Int             @default(1)
  updated_at  DateTime        @default(now()) @db.Timestamptz(6)

  @@map("field_set_versions")
}

model PermissionProfile {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code        String   @unique
  name_en     String
  name_ar     String?
  description String?
  is_active   Boolean  @default(true)
  version     Int      @default(1)
  reason      String?
  changed_by  String?  @db.Uuid
  changed_at  DateTime @default(now()) @db.Timestamptz(6)

  grants      PermissionGrant[]
  assignments UserRoleAssignmentProfile[]
  field_perms FieldPermission[]
  Role        Role[]

  @@map("permission_profiles")
}

// Grid cell: profile x module/screen x action. Presence = allowed. module_key is a module ("sites") or screen ("sites.tasks").
model PermissionGrant {
  profile_id String           @db.Uuid
  module_key String
  action     PermissionAction

  profile PermissionProfile @relation(fields: [profile_id], references: [id], onDelete: Cascade)

  @@id([profile_id, module_key, action])
  @@index([module_key])
  @@map("permission_grants")
}

// Profiles applied to assignments (many-to-many). Part of the assignment family (admin-only through the API, no RLS).
model UserRoleAssignmentProfile {
  assignment_id String @db.Uuid
  profile_id    String @db.Uuid

  assignment UserRoleAssignment @relation(fields: [assignment_id], references: [id], onDelete: Cascade)
  profile    PermissionProfile  @relation(fields: [profile_id], references: [id])

  @@id([assignment_id, profile_id])
  @@index([profile_id])
  @@map("user_role_assignment_profiles")
}

