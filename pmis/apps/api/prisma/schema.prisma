// ============================================================================
// 9. LOGS AND SETTINGS
// ============================================================================

// Append-only. Enforced by triggers in db/sql/001_audit_append_only.sql plus REVOKE UPDATE, DELETE.
model AuditLog {
  id                BigInt   @id @default(autoincrement())
  at                DateTime @default(now()) @db.Timestamptz(6)
  actor_id          String?  @db.Uuid
  on_behalf_of      String?  @db.Uuid
  action            String // create, update, delete, approve, reject, download, login, override ...
  entity_type       String
  entity_id         String?
  site_id           String?  @db.Uuid
  region_id         Int?
  before            Json?
  after             Json?
  reason            String?
  is_admin_override Boolean  @default(false)
  ip                String?
  user_agent        String?
  request_id        String?

  @@index([entity_type, entity_id])
  @@index([actor_id, at])
  @@index([site_id, at])
  @@index([at])
  @@map("audit_log")
}

// Separate from the audit log; purged after 12 months by a scheduled job.
model SystemLog {
  id         BigInt   @id @default(autoincrement())
  at         DateTime @default(now()) @db.Timestamptz(6)
  level      LogLevel
  source     String // api, importer, template-check, job
  message    String
  context    Json?
  user_id    String?  @db.Uuid
  request_id String?

  @@index([at])
  @@index([level, at])
  @@index([source, at])
  @@map("system_log")
}

model Setting {
  key         String   @id // require_mfa, geofence_radius_m, sla.default_levels ...
  value       Json
  description String?
  updated_by  String?  @db.Uuid
  updated_at  DateTime @updatedAt @db.Timestamptz(6)

  @@map("settings")
}
