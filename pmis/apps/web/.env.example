# true = browser MSW mock layer (default in `npm run dev`); false = talk to the real API.
VITE_USE_MOCKS=true
# Base URL of the real API (same-origin path works behind the BFF proxy).
VITE_API_BASE_URL=/api/v1
# Hybrid mode (needs VITE_USE_MOCKS=true): `auth-users` sends sign-in, session, /me, users and groups to the real server
# and keeps every other screen on mock data (list in src/mocks/realApi.ts). Empty = everything mocked.
VITE_REAL_API=
# Show the "Sign in with Microsoft 365" button (hidden until IT registers the app, ADR 0012).
VITE_M365_ENABLED=false
# Dev server only: forward /api to this server (for example the deployed one) in hybrid or real mode.
# VITE_PROXY_TARGET=https://pmis.example.internal
