{
  "mcpServers": {
    "playwright": {
      "command": "sh",
      "args": [".claude/mcp/playwright.sh"]
    },
    "perplexity": {
      "command": "npx",
      "args": ["-y", "@perplexity-ai/mcp-server@1.3.0"],
      "env": {
        "PERPLEXITY_API_KEY": "${PERPLEXITY_API_KEY:-}"
      }
    }
  }
}
